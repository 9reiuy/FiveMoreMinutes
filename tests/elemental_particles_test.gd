extends SceneTree
const SYSTEM=preload("res://scripts/dream/elemental_particles_3d.gd")
var checks:=0
var failures: Array[String]=[]
func _initialize() -> void: call_deferred("run")
func check(ok: bool,label: String) -> void:
	checks+=1
	if not ok: failures.append(label); push_error(label)
func run() -> void:
	var effect:=SYSTEM.new()
	root.add_child(effect)
	effect.set_process(false)
	effect.rng.seed=321
	var id:=effect.emit_fire(Vector3.ZERO)
	check(id>0,"Fire has a reusable stop handle")
	for i in 120: effect.step(1.0/60.0)
	check(effect.particles.size()>20,"Continuous fire produces overlapping particles")
	check(effect.banks.size()==3 and effect.lights.size()==4,"Bounded shared render/light pools")
	effect.stop_fire(id)
	for i in 240: effect.step(1.0/60.0)
	check(effect.particles.is_empty(),"Stop lets fire and smoke expire naturally")
	effect.explode(Vector3.ZERO)
	check(effect.particles.is_empty(),"Gas presentation owns its sparks without duplicating continuous-particle emissions")
	check(effect.explosion.bursts.size()==1,"Shared entry admits one gas burst")
	check(effect.explosion.library.frames.size()==101,"Shared gas library contains the imported CC0 animation")
	check(effect.explosion.find_children("*","CollisionObject3D",true,false).is_empty(),"Gas presentation adds no gameplay collision")
	check(effect.lights[0].visible and effect.lights[0].light_energy>1.0,"Ignition illuminates receiving geometry immediately")
	var initial_energy: float=effect.lights[0].light_energy
	effect.step(.1)
	check(absf(float(effect.explosion.bursts[0].age)-.1)<.001,"Fire and smoke use the shared scaled-time clock")
	check(effect.explosion.bursts.size()==1,"Gas burst remains alive through the ignition phase")
	check(effect.lights[0].light_energy<initial_energy,"White flash decays before the flame and smoke")
	effect.step(.1)
	check(not effect.lights.any(func(light: OmniLight3D)->bool:return light.visible),"Blast lighting expires after the short ignition pulse")
	for i in 240: effect.step(1.0/60.0)
	check(effect.particles.is_empty(),"Explosion cleans itself up")
	check(effect.explosion.bursts.is_empty() and effect.explosion.pool.all(func(node: Node3D)->bool:return not node.visible),"All gas instances retire after cooling")
	effect.emit_muzzle(Vector3.ZERO,Vector3.RIGHT)
	check(effect.particles.size()==20,"Muzzle contains twelve fire clumps and eight sparks")
	check(effect.particles.all(func(p: Dictionary)->bool:return Vector3(p.velocity).x>0.0),"Muzzle sprays forward along actual barrel direction")
	check(effect.particles.any(func(p: Dictionary)->bool:return int(p.kind)==2 and Vector3(p.velocity).length()>5),"Muzzle includes fast flying hot sparks")
	effect.clear()
	for side in [-1.0,1.0]:
		effect.clear(); effect.rng.seed=123; effect.clock=0.0
		effect.set_wind(Vector3(side*2,0,0))
		effect.emit_smoke(Vector3.ZERO,20)
		for i in 60: effect.step(1.0/60.0)
		var average:=0.0
		for particle in effect.particles: average+=Vector3(particle.at).x
		average/=maxi(1,effect.particles.size())
		check(average*side>.6,"Living particles respond to wind in either direction")
	effect.clear()
	effect.emit_fire(Vector3.ZERO,.3,.1)
	for i in 240: effect.step(1.0/60.0)
	check(effect.fires.is_empty() and effect.particles.is_empty(),"Timed fire expires")
	for i in 8: check(effect.emit_fire(Vector3.ZERO)>0,"Bounded fire emitter admitted")
	check(effect.emit_fire(Vector3.ZERO)==-1,"Emitter limit enforced")
	for i in 30: effect.explode(Vector3.ZERO)
	effect.step(10.0)
	check(effect.particles.size()<=SYSTEM.LIMIT,"Burst spam and long frames stay bounded")
	check(effect.explosion.bursts.size()<=effect.EXPLOSION.LIMIT and effect.explosion.rejected>0,"Burst geometry is bounded independently of continuous particles")
	effect.clear()
	check(effect.banks.all(func(bank: MultiMesh)->bool:return bank.visible_instance_count==0),"Clear hides all pooled geometry")
	check(effect.lights.all(func(light: OmniLight3D)->bool:return not light.visible),"Clear disables pooled lights")
	check(effect.outline_banks.all(func(bank: MultiMesh)->bool:return bank.visible_instance_count==0),"Clear also hides union contours")
	check(effect.explosion.bursts.is_empty() and effect.explosion.pool.all(func(node: Node3D)->bool:return not node.visible),"Clear also retires the gas pool")
	effect.emit_smoke(Vector3.ZERO,12)
	effect.set_wind(Vector3(-2,0,0))
	for i in 30: effect.step(1.0/60.0)
	effect.set_wind(Vector3(2,0,0))
	for i in 40: effect.step(1.0/60.0)
	check(effect.particles.all(func(particle: Dictionary)->bool:return Vector3(particle.velocity).x>0.0),"Changing wind steers particles that are already alive")
	effect.clear()
	for i in 8: effect.emit_fire(Vector3.ZERO)
	for i in 120:effect.step(1.0/60.0)
	var before:=effect.dropped
	for x in [-5.0,0.0,5.0]:effect.explode(Vector3(x,.65,0),1.5)
	check(effect.dropped==before and effect.explosion.bursts.size()==3,"Continuous fire reserves capacity for three simultaneous carriage blasts")
	check(effect.explosion.bursts[0].at!=effect.explosion.bursts[1].at and effect.explosion.bursts[1].at!=effect.explosion.bursts[2].at,"Three carriage blasts keep distinct floor-local origins")
	effect.clear()
	var burst_rng:=effect.rng.state
	effect.explode(Vector3(NAN,0,0))
	effect.explode(Vector3.ZERO,NAN)
	check(effect.explosion.bursts.is_empty() and effect.rng.state==burst_rng,"Invalid explosion inputs neither allocate nor advance randomness")
	effect.set_wind(Vector3.RIGHT*2)
	effect.explode(Vector3.ZERO)
	effect.step(.2)
	check(effect.explosion.bursts.any(func(b: Dictionary)->bool:return Vector3(b.drift).x>0.0),"Living gas follows local wind")
	effect.step(.2)
	check(effect.explosion.bursts.size()==1 and float(effect.explosion.bursts[0].age)>.39,"One continuous gas timeline covers fire cooling and smoke growth")
	effect.step(.2)
	effect.step(.1)
	check(effect.explosion.bursts.size()==1 and effect.explosion.DURATION>.7,"The gas tail outlives the short flash")
	effect.clear()
	effect.emit_fire(Vector3.ZERO)
	effect.explode(Vector3.ZERO)
	effect.step(.2)
	check(effect.lights[0].visible and is_equal_approx(effect.lights[0].omni_range,3.0) and effect.lights[0].light_energy<1.0,"Pooled flash light returns to unchanged continuous-fire settings")
	effect.free()
	print("ELEMENTAL_PARTICLES checks=",checks," failures=",failures.size())
	quit(0 if failures.is_empty() else 1)

extends "res://tests/h06_hangar_crew_test.gd"
## Freeze the existing approved smear painter's exact masks as static scenery.

func run() -> void:
	evidence=OS.get_environment("FORKLIFT_EVIDENCE")
	preload("res://tests/support/background_gpu.gd").start(self)
	force_dynamic_crew_blood=true
	await enter(CHAPTER.Save.RETURN_BAY)
	await frames(20)
	var folder := "res://art/Dream/SceneDressing/HangarCrew"
	DirAccess.make_dir_recursive_absolute(folder)
	var data := "extends RefCounted\n## Generated by tests/h06_crew_blood_bake.gd from the original blood painter.\nconst SEGMENTS := 30\nconst HEIGHT := 0.045\nconst STAMPS := [\n"
	var rows: Array=[]
	var count:=0
	for effect in world.world_effects_root.get_children():
		if not effect is BlackBloodEffect or not effect.get_meta(&"hangar_crew_scenery",false) or effect.is_queued_for_deletion():continue
		var mask: Image=effect.build_merged_ground_mask(112)
		if mask==null:push_error("Cannot bake original smear mask");quit(1);return
		var path:=folder.path_join("drag_%02d.res"%count)
		check(ResourceSaver.save(ImageTexture.create_from_image(mask),path,ResourceSaver.FLAG_COMPRESS)==OK,"save original merged smear texture")
		var p: Vector2=effect.global_position/32
		data+='\t{"at":Vector2(%.9f,%.9f),"texture":preload("%s"),"pixels":%d},\n'%[p.x,p.y,path,effect.ground_pixels.size()]
		rows.append({"path":path,"at":[p.x,p.y],"pixels":effect.ground_pixels.size()})
		mask.save_png(evidence.path_join("mask-%02d.png"%count))
		count+=1
	data+="]\n"
	FileAccess.open("res://scripts/testing/h06_chapter/hangar_crew_blood_data.gd",FileAccess.WRITE).store_string(data)
	FileAccess.open(folder.path_join("source.json"),FileAccess.WRITE).store_string(JSON.stringify({"source":"BlackBloodEffect.setup_drag_smear + pixel_blood_drag + exact ground-mask compaction","layout":"hangar_crew.gd LONG_TRAILS / SCATTERED","height":0.045,"stamp_count":count,"stamps":rows},"\t"))
	world._place_feet(Vector2(3.4,1.5))
	await frames(30)
	await photograph("original-painter-reference")
	print("H06_CREW_BLOOD_BAKE stamps=",count)
	await unload()
	quit()

extends SceneTree
const SYSTEM := preload("res://scripts/dream/surface_blood_system.gd")
const FLOOR := preload("res://scripts/dream/floor_surface_blood.gd")
var failures := 0
var checks := 0
func _initialize() -> void: call_deferred("run")
func check(ok: bool, label: String) -> void:
	checks += 1
	print("PASS " if ok else "FAIL ", label)
	if not ok: failures += 1
func run() -> void:
	AudioServer.set_bus_mute(0, true)
	var scene := Node3D.new()
	root.add_child(scene)
	var system := SYSTEM.new()
	scene.add_child(system)
	var floor_filter := FLOOR.new()
	var solid := MeshInstance3D.new()
	solid.mesh = BoxMesh.new()
	scene.add_child(solid)
	check(floor_filter._eligible(solid), "Ordinary solid remains a floor blood receiver")
	check(system.register_receiver(solid, "solid", true) == 0, "Ordinary geometry retains its surface query")
	var transient := MeshInstance3D.new()
	transient.mesh = SphereMesh.new()
	transient.set_meta(&"surface_blood_excluded", true)
	scene.add_child(transient)
	check(not floor_filter._eligible(transient), "Transient visual is rejected before floor registration")
	check(system.register_receiver(transient, "effect", true) == -1, "Direct registration also rejects transient geometry")
	check(transient.find_children("*", "CollisionObject3D", true, false).is_empty(), "Excluded effect creates no surface-query collision")
	var mixed := Node3D.new()
	scene.add_child(mixed)
	var part := MeshInstance3D.new()
	part.mesh = BoxMesh.new()
	mixed.add_child(part)
	var flame := MeshInstance3D.new()
	flame.mesh = SphereMesh.new()
	flame.set_meta(&"surface_blood_excluded", true)
	mixed.add_child(flame)
	var index := system.register_receiver(mixed, "mixed", true)
	check(index == 1 and system.receivers[index].originals.size() == 1, "Mixed owner registers only actual solid triangles")
	check((flame.layers & SYSTEM.RECEIVER_LAYER) == 0, "Excluded mesh never gains the blood receiver render layer")
	check((part.layers & SYSTEM.RECEIVER_LAYER) != 0, "Solid child keeps its blood receiver render layer")
	transient.set_meta(&"surface_blood_excluded", false)
	check(system.register_receiver(transient, "restored", true) >= 0, "Exclusion does not poison later normal registration")
	floor_filter.free()
	scene.free()
	await process_frame
	print("BLOOD_RECEIVER_FILTER checks=", checks, " failures=", failures)
	quit(0 if failures == 0 else 1)

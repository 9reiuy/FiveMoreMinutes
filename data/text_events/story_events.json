      {"text": "今天不用再赶了。", "typewriter_speed": 0.05, "text_color": "#C4C0C3", "font_size": 20, "wait_for_input": true, "blip": true},
      {"text": "旷工。", "typewriter_speed": 0.05, "text_color": "#C4C0C3", "font_size": 20, "wait_for_input": true, "blip": true}
    ]},

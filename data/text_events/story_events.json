      {"text": "你看了一眼时间。", "typewriter_speed": 0.05, "text_color": "#C4C0C3", "font_size": 20, "wait_for_input": true, "blip": true},
      {"text": "今天又迟到了。", "typewriter_speed": 0.05, "text_color": "#C4C0C3", "font_size": 20, "wait_for_input": true, "blip": true},
